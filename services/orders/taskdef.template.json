{
  "family": "ecs-microservices-orders",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "REPLACE_WITH_EXECUTION_ROLE_ARN_OUTPUT",
  "taskRoleArn": "REPLACE_WITH_ORDERS_TASK_ROLE_ARN_OUTPUT",
  "containerDefinitions": [
    {
      "name": "orders",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "SERVICE_NAME", "value": "orders" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-microservices-orders",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "orders"
        }
      }
    }
  ]
}
